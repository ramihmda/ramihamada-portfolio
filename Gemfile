source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages runs, so a local
# `bundle exec jekyll serve` renders the same thing the live site does.
gem "github-pages", group: :jekyll_plugins

# Ruby 3.0+ dropped webrick from stdlib; jekyll serve needs it.
gem "webrick", "~> 1.8"

gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
